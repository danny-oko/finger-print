# ─────────────────────────────────────────────────────────────
# Cloudflare D1 — accessed over the REST API (this app runs on
# Vercel, not Cloudflare Workers, so there is no native binding).
# See docs/registration-setup.md for how to obtain these.
# ─────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_API_TOKEN=your-d1-edit-api-token

# ─────────────────────────────────────────────────────────────
# Byl payment gateway (byl.mn)
# Create an API token at Byl dashboard → Settings → API Token.
# The project id is the number in your project's dashboard URL.
# The webhook secret is the signing secret shown on the webhook
# endpoint's detail page (Webhooks → your endpoint).
# See docs/registration-setup.md.
# ─────────────────────────────────────────────────────────────
BYL_API_BASE_URL=https://byl.mn/api/v1
BYL_PROJECT_ID=your-byl-project-id
BYL_API_TOKEN=your-byl-api-token
BYL_WEBHOOK_SECRET=your-byl-webhook-signing-secret

# ─────────────────────────────────────────────────────────────
# Gmail SMTP — OPTIONAL. When set, a QR ticket email goes out once a
# registration is paid. Leave both blank and tickets are still issued;
# registrants just get them from the success page instead of by email.
# Use a Gmail *App Password*, not your normal account password.
# See docs/registration-setup.md for how to create one.
# ─────────────────────────────────────────────────────────────
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# Used to build the Byl success/cancel URLs after payment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Admin dashboard (/admin/registration-monitor)
# The login is OPT-IN: leave ADMIN_PASSWORD unset and the dashboard is
# open to anyone with the URL (it shows a warning banner saying so).
# Set it to turn the login on — no code change needed.
# ADMIN_SESSION_SECRET signs the session cookie; only needed once
# ADMIN_PASSWORD is set. Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_SESSION_SECRET=generate-a-long-random-string
