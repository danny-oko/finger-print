# ─────────────────────────────────────────────────────────────
# Cloudflare D1 — accessed over the REST API (this app runs on
# Vercel, not Cloudflare Workers, so there is no native binding).
# See docs/registration-setup.md for how to obtain these.
# ─────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_API_TOKEN=your-d1-edit-api-token

# ─────────────────────────────────────────────────────────────
# Bonum Payment Gateway (psp.bonum.mn)
# The values below are Bonum's own PUBLISHED SANDBOX credentials
# (safe to commit, test-only). Replace all four with real values
# from https://merchant.bonum.mn/ before going to production.
# ─────────────────────────────────────────────────────────────
BONUM_BASE_URL=https://testapi.bonum.mn
BONUM_APP_SECRET=1fc53f9389f489ff6e04617bd6338a710e1e7c579cb572aec421f560f363119c0e0039e4b765e53c5339c1e6c77279854b20e998ed4599983a9c9dba12b36e89ce7ee7659043ebffcf77a095587bf694
BONUM_TERMINAL_ID=17171119
BONUM_MERCHANT_CHECKSUM_KEY=755753df1f8fb16da1131cc318f1bcec9b5df3e39ae5dee902900cd186e7ece8

# ─────────────────────────────────────────────────────────────
# Gmail SMTP — sends the QR ticket email once a registration is paid.
# Use a Gmail *App Password*, not your normal account password.
# See docs/registration-setup.md for how to create one.
# ─────────────────────────────────────────────────────────────
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# Used to build the Bonum callback URL after payment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
